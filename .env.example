# EchoLens configuration. Copy to .env and adjust.
# Every setting is prefixed ECHOLENS_ and read by backend/app/config.py.

# ─── Database ──────────────────────────────────────────────────────────────
# Dev bridge (no installs required). Phase 1-2 only.
ECHOLENS_DATABASE_URL=sqlite+aiosqlite:///./echolens.db

# Real stack. Required from Phase 3 — SQLite has no vector search.
# ECHOLENS_DATABASE_URL=postgresql+asyncpg://echolens:echolens@localhost:5432/echolens

# ─── Object storage ────────────────────────────────────────────────────────
# local | s3
ECHOLENS_STORAGE_BACKEND=local
ECHOLENS_STORAGE_LOCAL_PATH=./storage

# Used when ECHOLENS_STORAGE_BACKEND=s3 (MinIO in dev, AWS in prod)
ECHOLENS_S3_ENDPOINT_URL=http://localhost:9000
ECHOLENS_S3_BUCKET=echolens
ECHOLENS_S3_ACCESS_KEY=echolens
ECHOLENS_S3_SECRET_KEY=echolens-dev-secret
ECHOLENS_S3_REGION=us-east-1

# ─── Queue (Phase 2) ───────────────────────────────────────────────────────
ECHOLENS_REDIS_URL=redis://localhost:6379/0

# ─── Uploads ───────────────────────────────────────────────────────────────
# 16 GiB ceiling. Uploads stream to storage, so this bounds disk, not memory.
ECHOLENS_MAX_UPLOAD_BYTES=17179869184
ECHOLENS_UPLOAD_CHUNK_BYTES=1048576

# ─── API ───────────────────────────────────────────────────────────────────
ECHOLENS_CORS_ORIGINS=http://localhost:3000
ECHOLENS_LOG_LEVEL=INFO
# Where this app is reachable in a browser. Only used to build the deep links
# in a Markdown transcript export; leave it wrong and the links point at a
# machine the reader cannot open.
ECHOLENS_APP_BASE_URL=http://localhost:3000
